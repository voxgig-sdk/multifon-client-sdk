# Entity: api

main: kit: entity: api: {

  alias: field: {}

  fields: {
    message: {
      h: "Message"
      n: "message"
      r: false
      sh: "Success message"
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
  }

  name: "api"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "currentPassword"
            "enabled"
            "lines"
            "newPassword"
            "rules"
            "status"
          ]
          co: {
            id: "POST /api"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "method"
                or: "method"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/api"
          q: {
            exist: [
              "method"
            ]
          }
          rb: {
            alternatives: [
              {
                fields: [
                  {
                    name: "value"
                  }
                ]
                kind: "form"
                media: "application/x-www-form-urlencoded"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
