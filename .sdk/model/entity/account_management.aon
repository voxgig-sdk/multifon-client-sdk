            json: "{\"operationId\":\"getAccountInfo\",\"parameters\":[{\"description\":\"The method to retrieve specific information\",\"in\":\"query\",\"name\":\"method\",\"required\":true,\"schema\":{\"enum\":[\"getRouting\",\"getCallingLines\",\"getStatus\",\"getBalance\",\"getProfile\"],\"type\":\"string\"}},{\"description\":\"Authentication token or credentials\",\"in\":\"query\",\"name\":\"auth\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"oneOf\":[{\"properties\":{\"routing\":{\"properties\":{\"enabled\":{\"description\":\"Whether routing is enabled\",\"type\":\"boolean\"},\"rules\":{\"items\":{\"properties\":{\"destination\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"priority\":{\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"},{\"properties\":{\"lines\":{\"items\":{\"properties\":{\"active\":{\"description\":\"Whether the line is active\",\"type\":\"boolean\"},\"name\":{\"description\":\"Line name or label\",\"type\":\"string\"},\"number\":{\"description\":\"Phone number\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},{\"properties\":{\"lastUpdated\":{\"description\":\"Last status update timestamp\",\"format\":\"date-time\",\"type\":\"string\"},\"status\":{\"description\":\"Current account status\",\"enum\":[\"active\",\"inactive\",\"suspended\"],\"type\":\"string\"}},\"type\":\"object\"},{\"properties\":{\"balance\":{\"description\":\"Current account balance\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"Currency code\",\"example\":\"RUB\",\"type\":\"string\"},\"lastUpdated\":{\"description\":\"Last balance update timestamp\",\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},{\"properties\":{\"profile\":{\"properties\":{\"email\":{\"description\":\"Email address\",\"format\":\"email\",\"type\":\"string\"},\"name\":{\"description\":\"User full name\",\"type\":\"string\"},\"phoneNumber\":{\"description\":\"Primary phone number\",\"type\":\"string\"},\"registrationDate\":{\"description\":\"Account registration date\",\"format\":\"date-time\",\"type\":\"string\"},\"userId\":{\"description\":\"User identifier\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}]}}},\"description\":\"Successful response\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Bad request - Invalid parameters\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - Authentication required or failed\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"security\":[{\"ApiKeyAuth\":[]},{\"BasicAuth\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"API key authentication via query parameter\",\"in\":\"query\",\"name\":\"auth\",\"type\":\"apiKey\"},\"BasicAuth\":{\"description\":\"Basic HTTP authentication\",\"scheme\":\"basic\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
